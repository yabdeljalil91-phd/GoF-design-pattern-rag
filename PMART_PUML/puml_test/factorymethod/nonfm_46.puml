@startuml
package dpd_jdt {
	package Factory_method {
		package nonfactorymethod {
			'@interface SelectionModel
			'@date 08-20-2001
			'@author Eric Crahen
			'@version 1.0This is a simpled implementation of a model that keeps track of selected Figures. The selection model needs to keep track of a set of selected Figures. - Adding figures - Removing figures - Testing for figures
			interface SelectionModel {
				'Add one item to the current selection
				'@param Figure
				add(figure : Figure)
				'Add one item to the current selection
				'@param Figure
				'@param boolean clear flag
				add(f : Figure, reset : JavaPrimitiveTypes.boolean)
				'Add a new listener to this model.
				'@param DiagramSelectionListener
				addSelectionListener(listener : DiagramSelectionListener)
				'Remove all items from the current selection
				clear()
				'Test an item to see if it is a member of the current selection.
				'@param Figure
				'@return boolean
				contains(figure : Figure): JavaPrimitiveTypes.boolean
				'Test an item to see if it is a member of the current selection.
				'@param Link
				'@return boolean
				contains(link : Link): JavaPrimitiveTypes.boolean
				'Get an Iterator over the currently selected items of a certain Class hierarchy.
				'@return Iterator
				iterator(): java.util.Iterator
				'Remove one item from the current selection
				'@param Figure
				remove(figure : Figure)
				'Remove a listener to this model.
				'@param DiagramSelectionListener
				removeSelectionListener(listener : DiagramSelectionListener)
				'Get the size of the current selection.
				'@return int
				size(): JavaPrimitiveTypes.int
				'Get all selected items. The items returned will be pruned by the arryas element class if any. Passing a Figure[] array would return all Figure classes & subclasses in the selection model.
				'@param Object[] - avoid allocating a new array
				'@return Object[]
				toArray(array : java.lang.Object): java.lang.Object
			}
		}
	}
	java.lang.Cloneable <|-- Factory_method.nonfactorymethod.Figure
	java.io.Serializable <|-- Factory_method.nonfactorymethod.Figure
}
@enduml
