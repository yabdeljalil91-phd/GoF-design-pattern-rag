@startuml
package dpd_jdt {
	package Factory_method {
		package nonfactorymethod {
			'@class FileAction
			'@date 08-20-2001
			'@author Eric Crahen
			'@version 1.0Action that provides a smarter JFileChooser
			abstract class FileAction {
				-chooser: SmartChooser
				'Create a new action
				<<Create>> FileAction(name : java.lang.String, icon : javax.swing.Icon)
				'Create a new action
				<<Create>> FileAction(name : java.lang.String)
				'Get the JFileChooser shared among all FileActions
				#getChooser(): SmartChooser
			}
		}
	}
	javax.swing.AbstractAction <|-- Factory_method.nonfactorymethod.FileAction
	java.io.File "lastDirectory" <-- Factory_method.nonfactorymethod.FileAction.SmartChooser
	Factory_method.nonfactorymethod.FileAction.SmartChooser "chooser" <-- Factory_method.nonfactorymethod.FileAction
	java.lang.String "description" <-- Factory_method.nonfactorymethod.FileAction.SimpleFilter
	java.lang.String "extensions 0..*" <-- Factory_method.nonfactorymethod.FileAction.SimpleFilter
}
@enduml
