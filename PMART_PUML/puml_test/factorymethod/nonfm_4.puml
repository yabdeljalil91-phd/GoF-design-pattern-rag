@startuml
package dpd_jdt {
	package Factory_method {
		package nonfactorymethod {
			'This FilterFactory descendant adds the JavaDoc property to every Method, Constructor, Field and class node create for JavaDataObjects
			'@author Petr Hrebejk
			class JavaDocPropertySupportFactory {
				-{const} PROP_JAVADOCCOMMENT: java.lang.String = javadocComment
				#{const} bundle: java.util.ResourceBundle
				<<Create>> JavaDocPropertySupportFactory()
				'Adds JavaDoc property to node for class
				{static} addClassJavaDocProperty(node : Node)
				'Adds JavaDoc property to node for field
				{static} addFieldJavaDocProperty(node : Node)
				'Adds JavaDoc property to node for method
				{static} addMethodJavaDocProperty(node : Node)
				'Create a node property for javadoc comment for class element
				'@param canW if <code>false</code>, property will be read-only
				'@return the property
				#{static} createClassJavaDocProperty(canW : JavaPrimitiveTypes.boolean, node : Node): Node.Property
				createClassNode(element : ClassElement): Node
				createConstructorNode(element : ConstructorElement): Node
				'Create a node property for javadoc comment for method element
				'@param canW if <code>false</code>, property will be read-only
				'@return the property
				#{static} createFieldJavaDocProperty(canW : JavaPrimitiveTypes.boolean, node : Node): Node.Property
				createFieldNode(element : FieldElement): Node
				'Create a node property for javadoc comment for field element
				'@param canW if <code>false</code>, property will be read-only
				'@return the property
				#{static} createMethodJavaDocProperty(canW : JavaPrimitiveTypes.boolean, node : Node): Node.Property
				createMethodNode(element : MethodElement): Node
			}
		}
	}
	Factory_method.nonfactorymethod.FilterFactory <|-- Factory_method.nonfactorymethod.JavaDocPropertySupportFactory
	Factory_method.nonfactorymethod.ElementNodeFactory <|.. Factory_method.nonfactorymethod.FilterFactory
	Factory_method.nonfactorymethod.ElementNodeFactory "delegate" <-- Factory_method.nonfactorymethod.FilterFactory
	java.lang.String "PROP_JAVADOCCOMMENT" <-- Factory_method.nonfactorymethod.JavaDocPropertySupportFactory
	java.util.ResourceBundle "bundle" <-- Factory_method.nonfactorymethod.JavaDocPropertySupportFactory
}
@enduml
