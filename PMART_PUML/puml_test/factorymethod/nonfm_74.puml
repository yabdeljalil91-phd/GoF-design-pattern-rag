@startuml
package dpd_jdt {
	package Factory_method {
		package nonfactorymethod {
			'Base class for source browsing. This is the generic base class.
			'@author    Chris Seguin
			abstract class SourceBrowser {
				-{static} singleton: SourceBrowser
				<<Create>> SourceBrowser()
				'Determines if the system is in a state where it can browse the source code
				'@return    true if the source code browsing is enabled
				canBrowseSource(): JavaPrimitiveTypes.boolean
				'Gets the singleton source browser
				'@return    the current source browser
				{static} get(): SourceBrowser
				'Actually browses to the file
				'@param line      the line in the file
				'@param file      Description of Parameter
				gotoSource(file : java.io.File, line : JavaPrimitiveTypes.int)
				'Sets the singleton source browser
				'@param value  the new singleton
				{static} set(value : SourceBrowser)
			}
		}
	}
}
@enduml
