@startuml
package dpd_jdt {
	package Factory_method {
		package nonfactorymethod {
			'Figures to connect Connectors provided by Figures. A ConnectionFigure knows its start and end Connector. It uses the Connectors to locate its connection points.<p> A ConnectionFigure can have multiple segments. It provides operations to split and join segments. <hr> <b>Design Patterns</b><P> <img src="images/red-ball-small.gif" width=6 height=6 alt=" o "> <b><a href=../pattlets/sld034.htm>Strategy</a></b><br> Strategy is used encapsulate the algorithm to locate the connection point. ConnectionFigure is the Strategy context and Connector is the Strategy.<br> <img src="images/red-ball-small.gif" width=6 height=6 alt=" o "> <b><a href=../pattlets/sld026.htm>Observer</a></b><br> Observer is used to track changes of the connected figures. A connection figure registers itself as listeners or observers of the source and target connector. <hr>
			'@see Connector
			interface ConnectionFigure {
				'Checks if two figures can be connected. Implement this method to constrain the allowed connections between figures.
				canConnect(start : Figure, end : Figure): JavaPrimitiveTypes.boolean
				'Sets the end Connector of the connection.
				'@param figure the end figure of the connection
				connectEnd(end : Connector)
				'Sets the start Connector of the connection.
				'@param figure the start figure of the connection
				connectStart(start : Connector)
				'Checks if the ConnectionFigure connects the same figures.
				connectsSame(other : ConnectionFigure): JavaPrimitiveTypes.boolean
				'Disconnects the end figure from the dependent figure
				disconnectEnd()
				'Disconnects the start figure from the dependent figure
				disconnectStart()
				'Gets the end Connector.
				end(): Connector
				'Sets the end point.
				endPoint(x : JavaPrimitiveTypes.int, y : JavaPrimitiveTypes.int)
				'Gets the end point.
				endPoint(): java.awt.Point
				'Joins the hit segments.
				'@param x, y the position where the figure should be joined.
				'@return whether the segment was joined
				joinSegments(x : JavaPrimitiveTypes.int, y : JavaPrimitiveTypes.int): JavaPrimitiveTypes.boolean
				'Gets the Point at the given position
				pointAt(index : JavaPrimitiveTypes.int): java.awt.Point
				'Gets the number of points or nodes of the connection
				pointCount(): JavaPrimitiveTypes.int
				'Sets the position of the point at the given position
				setPointAt(p : java.awt.Point, index : JavaPrimitiveTypes.int)
				'Splits the hit segment.
				'@param x, y the position where the figure should be split
				'@return the index of the splitting point
				splitSegment(x : JavaPrimitiveTypes.int, y : JavaPrimitiveTypes.int): JavaPrimitiveTypes.int
				'Gets the start Connector
				start(): Connector
				'Sets the start point.
				startPoint(x : JavaPrimitiveTypes.int, y : JavaPrimitiveTypes.int)
				'Gets the start point.
				startPoint(): java.awt.Point
				'Updates the connection
				updateConnection()
			}
		}
	}
	Factory_method.nonfactorymethod.Figure <|-- Factory_method.nonfactorymethod.ConnectionFigure
	java.lang.Cloneable <|-- Factory_method.nonfactorymethod.Figure
