@startuml
package dpd_jdt {
	package Builder {
		package nonbuilder {
			'The Iconkit class supports the sharing of images. It maintains a map of image names and their corresponding images. Iconkit also supports to load a collection of images in synchronized way. The resolution of a path name to an image is delegated to the DrawingEditor. <hr> <b>Design Patterns</b><P> <img src="images/red-ball-small.gif" width=6 height=6 alt=" o "> <b><a href=../pattlets/sld031.htm>Singleton</a></b><br> The Iconkit is a singleton. <hr>
			class Iconkit {
				-{const} ID: JavaPrimitiveTypes.int = 123
				-fComponent: java.awt.Component
				-fMap: java.util.Hashtable
				-fRegisteredImages: java.util.Vector
				-{static} fgDebug: JavaPrimitiveTypes.boolean
				-{static} fgIconkit: Iconkit
				'Constructs an Iconkit that uses the given editor to resolve image path names.
				<<Create>> Iconkit(component : java.awt.Component)
				-basicGetImage(filename : java.lang.String): java.awt.Image
				'Gets the image with the given name. If the image can't be found it tries it again after loading all the registered images.
				getImage(filename : java.lang.String): java.awt.Image
				'Gets the single instance
				{static} instance(): Iconkit
				'Loads an image with the given name.
				loadImage(filename : java.lang.String): java.awt.Image
				loadImageResource(resourcename : java.lang.String): java.awt.Image
				'Loads all registered images.
				'@see #registerImage
				loadRegisteredImages(component : java.awt.Component)
				'Registers and loads an image.
				registerAndLoadImage(component : java.awt.Component, fileName : java.lang.String): java.awt.Image
				'Registers an image that is then loaded together with the other registered images by loadRegisteredImages.
				'@see #loadRegisteredImages
				registerImage(fileName : java.lang.String)
			}
		}
	}
	JavaPrimitiveTypes.int "ID" <-- Builder.nonbuilder.Iconkit
	java.awt.Component "fComponent" <-- Builder.nonbuilder.Iconkit
	java.util.Hashtable "fMap" <-- Builder.nonbuilder.Iconkit
	java.util.Vector "fRegisteredImages" <-- Builder.nonbuilder.Iconkit
	JavaPrimitiveTypes.boolean "fgDebug" <-- Builder.nonbuilder.Iconkit
}
@enduml
