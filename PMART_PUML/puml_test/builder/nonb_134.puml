@startuml
package dpd_jdt {
	package Context {
		package nonContext {
			'Adds property pattern node to stansdard Java class node
			'@author Petr Hrebejk
			class PatternsExplorerFactory {
				-writeable: JavaPrimitiveTypes.boolean
				<<Create>> PatternsExplorerFactory(writeable : JavaPrimitiveTypes.boolean)
				createClassNode(element : ClassElement): Node
			}
		}
	}
	Context.nonContext.FilterFactory <|-- Context.nonContext.PatternsExplorerFactory
	Context.nonContext.ElementNodeFactory <|.. Context.nonContext.FilterFactory
	Context.nonContext.ElementNodeFactory "delegate" <-- Context.nonContext.FilterFactory
	JavaPrimitiveTypes.boolean "writeable" <-- Context.nonContext.PatternsExplorerFactory
}
@enduml
