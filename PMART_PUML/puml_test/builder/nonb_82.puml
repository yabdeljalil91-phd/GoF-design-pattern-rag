@startuml
package dpd_jdt {
	package Builder {
		package nonbuilder {
			'@class FileAction
			'@date 08-20-2001
			'@author Eric Crahen
			'@version 1.0Action that provides a smarter JFileChooser
			abstract class FileAction {
				-chooser: SmartChooser
				'Create a new action
				<<Create>> FileAction(name : java.lang.String, icon : javax.swing.Icon)
				'Create a new action
				<<Create>> FileAction(name : java.lang.String)
				'Get the JFileChooser shared among all FileActions
				#getChooser(): SmartChooser
			}
		}
	}
	javax.swing.AbstractAction <|-- Builder.nonbuilder.FileAction
	java.io.File "lastDirectory" <-- Builder.nonbuilder.FileAction.SmartChooser
	Builder.nonbuilder.FileAction.SmartChooser "chooser" <-- Builder.nonbuilder.FileAction
	java.lang.String "description" <-- Builder.nonbuilder.FileAction.SimpleFilter
	java.lang.String "extensions 0..*" <-- Builder.nonbuilder.FileAction.SimpleFilter
}
@enduml
