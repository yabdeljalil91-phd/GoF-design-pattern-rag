@startuml
package dpd_jdt {
	package Builder {
		package nonbuilder {
			'Document manager for UML files
			'@author    Chris Seguin
			class UMLDocManager {
				-reloader: SingleDirClassDiagramReloader
				'Constructor for the UMLDocManager object
				<<Create>> UMLDocManager()
				'Get the default extension associated with this document type
				'@return    The Extension value
				getExtension(): java.lang.String
				'Get the name of the document type.
				'@return    The Name value
				getName(): java.lang.String
				'Gets the reloader object
				getReloader(): SingleDirClassDiagramReloader
				'Create a new TNode which can represent the given file within the project tree.
				'@param parent  Description of Parameter
				'@param file    Description of Parameter
				'@return         The TreeNode value
				getTreeNode(parent : TNode, file : java.io.File): TNode
				'Create a new ViewManager which can show the given filename
				'@param filename  Description of Parameter
				'@return           The ViewManager value
				getViewManager(filename : java.lang.String): ViewManager
				'Determine whether this document type can be created by the user through the "New File" dialog.
				'@return    The UserCreated value
				isUserCreated(): JavaPrimitiveTypes.boolean
				'Test whether a filename is valid for a particular kind of document
				'@param filename  Description of Parameter
				'@return           The ValidFilename value
				isValidFilename(filename : java.lang.String): JavaPrimitiveTypes.boolean
				'Description of the Method
				'@return    Description of the Returned Value
				toString(): java.lang.String
			}
		}
	}
	Builder.nonbuilder.DocManager <|-- Builder.nonbuilder.UMLDocManager
	Builder.nonbuilder.SingleDirClassDiagramReloader "reloader" <-- Builder.nonbuilder.UMLDocManager
}
@enduml
