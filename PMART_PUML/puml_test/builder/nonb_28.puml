@startuml
package dpd_jdt {
	package Builder {
		package nonbuilder {
			'This is the default filter that is currently being used by the system. It allows all packages that have at least one type summary to be included in the list.
			'@author    Chris Seguin
			class DefaultPackageListFilter {
				<<Create>> DefaultPackageListFilter()
				'Returns true if we should include it
				'@param summary  the summary in question
				'@return          true if it should be included
				isIncluded(summary : PackageSummary): JavaPrimitiveTypes.boolean
			}
		}
	}
	Builder.nonbuilder.PackageListFilter <|-- Builder.nonbuilder.DefaultPackageListFilter
}
@enduml
