@startuml
package dpd_jdt {
	package Builder {
		package nonbuilder {
			'This class runs the pretty printer for Symantec Visual Cafe 
			'@author     Chris Seguin 
			'@created    August 23, 2000
			class CafePrettyPrinter {
				-sourceFile: SourceFile
				<<Create>> CafePrettyPrinter()
				'This is invoked when the user selects pretty printer 
				'@param evt  The action event
				actionPerformed(evt : java.awt.event.ActionEvent)
				'Returns the initial line number
				#getLineNumber(): JavaPrimitiveTypes.int
				'Gets the initial string from the IDE 
				'@return    The file in string format
				#getStringFromIDE(): java.lang.String
				'Sets the line number
				#setLineNumber(value : JavaPrimitiveTypes.int)
				'Sets the string in the IDE 
				'@param value  The new file contained in a string
				#setStringInIDE(value : java.lang.String)
			}
		}
	}
	java.awt.event.ActionListener <|.. Builder.nonbuilder.CafePrettyPrinter
	Builder.nonbuilder.PrettyPrintFromIDE <|-- Builder.nonbuilder.CafePrettyPrinter
	Builder.nonbuilder.SourceFile "sourceFile" <-- Builder.nonbuilder.CafePrettyPrinter
}
@enduml
