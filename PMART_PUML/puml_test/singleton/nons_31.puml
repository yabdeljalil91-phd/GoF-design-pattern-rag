@startuml
package dpd_jdt {
	package Holder {
		package nonHolder {
			'Stores a view of a UML class diagram
			'@author    Chris Seguin
			class UMLNodeViewer {
				-diagram: UMLPackage
				-reloader: ClassDiagramReloader
				'Constructor for the UMLNodeViewer object
				'@param summary  Description of Parameter
				'@param init     Description of Parameter
				<<Create>> UMLNodeViewer(summary : PackageSummary, init : ClassDiagramReloader)
				'Constructor for the UMLNodeViewer object
				'@param context  Description of Parameter
				'@param init     Description of Parameter
				<<Create>> UMLNodeViewer(context : Context, init : ClassDiagramReloader)
				'Creates a summary component, which is blank
				'@return    the component
				createStructureComponent(): javax.swing.JComponent
				'Creates the main viewer
				'@return    the viewer
				createViewerComponent(): javax.swing.JComponent
				'Gets the Diagram attribute of the UMLNodeViewer object
				'@return    The Diagram value
				getDiagram(): UMLPackage
				'Gets the ViewerTitle attribute of the UMLNodeViewer object
				'@return    The ViewerTitle value
				getViewerTitle(): java.lang.String
				'Releases the viewer
				releaseViewer()
			}
		}
	}
	Holder.nonHolder.AbstractNodeViewer <|-- Holder.nonHolder.UMLNodeViewer
	Holder.nonHolder.UMLPackage "diagram" <-- Holder.nonHolder.UMLNodeViewer
	Holder.nonHolder.ClassDiagramReloader "reloader" <-- Holder.nonHolder.UMLNodeViewer
}
@enduml
