@startuml
package dpd_jdt {
	package Holder {
		package nonHolder {
			'Adds properties & events to the ClassElementNode
			'@author Jan Jancura
			class PatternsBrowserFactory {
				-{const} CLASS_ACTIONS: SystemAction [*]
				-writeable: JavaPrimitiveTypes.boolean
				<<Create>> PatternsBrowserFactory(writeable : JavaPrimitiveTypes.boolean)
				createClassNode(element : ClassElement): Node
			}
		}
	}
	Holder.nonHolder.FilterFactory <|-- Holder.nonHolder.PatternsBrowserFactory
	Holder.nonHolder.ElementNodeFactory <|.. Holder.nonHolder.FilterFactory
	Holder.nonHolder.ElementNodeFactory "delegate" <-- Holder.nonHolder.FilterFactory
	Holder.nonHolder.SystemAction "CLASS_ACTIONS 0..*" <-- Holder.nonHolder.PatternsBrowserFactory
	JavaPrimitiveTypes.boolean "writeable" <-- Holder.nonHolder.PatternsBrowserFactory
}
@enduml
