@startuml
package dpd_jdt {
	package Singleton {
		package nonsingleton {
			'A LineConnection that constrains a connection to orthogonal lines.
			class ElbowConnection {
				-elbowConnectionSerializedDataVersion: JavaPrimitiveTypes.int
				-{const} serialVersionUID: JavaPrimitiveTypes.long = 2193968743082078559
				<<Create>> ElbowConnection()
				connectedTextLocator(f : Figure): Locator
				'Gets the handles of the figure.
				handles(): java.util.Vector
				layoutConnection()
				updateConnection()
				#updatePoints()
			}
		}
	}
	Singleton.nonsingleton.LineConnection <|-- Singleton.nonsingleton.ElbowConnection
	Singleton.nonsingleton.ConnectionFigure <|.. Singleton.nonsingleton.LineConnection
	Singleton.nonsingleton.PolyLineFigure <|-- Singleton.nonsingleton.LineConnection
	Singleton.nonsingleton.AbstractFigure <|-- Singleton.nonsingleton.PolyLineFigure
	Singleton.nonsingleton.Figure <|-- Singleton.nonsingleton.ConnectionFigure
	java.lang.Cloneable <|-- Singleton.nonsingleton.Figure
	java.io.Serializable <|-- Singleton.nonsingleton.Figure
	JavaPrimitiveTypes.int "ARROW_TIP_BOTH" <-- Singleton.nonsingleton.PolyLineFigure
	JavaPrimitiveTypes.int "ARROW_TIP_END" <-- Singleton.nonsingleton.PolyLineFigure
	JavaPrimitiveTypes.int "ARROW_TIP_NONE" <-- Singleton.nonsingleton.PolyLineFigure
	JavaPrimitiveTypes.int "ARROW_TIP_START" <-- Singleton.nonsingleton.PolyLineFigure
	Singleton.nonsingleton.LineDecoration "fEndDecoration" <-- Singleton.nonsingleton.PolyLineFigure
	java.awt.Color "fFrameColor" <-- Singleton.nonsingleton.PolyLineFigure
	java.util.Vector "fPoints" <-- Singleton.nonsingleton.PolyLineFigure
	Singleton.nonsingleton.LineDecoration "fStartDecoration" <-- Singleton.nonsingleton.PolyLineFigure
	JavaPrimitiveTypes.int "polyLineFigureSerializedDataVersion" <-- Singleton.nonsingleton.PolyLineFigure
	JavaPrimitiveTypes.long "serialVersionUID" <-- Singleton.nonsingleton.PolyLineFigure
	Singleton.nonsingleton.Connector "fEnd" <-- Singleton.nonsingleton.LineConnection
	Singleton.nonsingleton.Connector "fStart" <-- Singleton.nonsingleton.LineConnection
	JavaPrimitiveTypes.int "lineConnectionSerializedDataVersion" <-- Singleton.nonsingleton.LineConnection
	JavaPrimitiveTypes.long "serialVersionUID" <-- Singleton.nonsingleton.LineConnection
	JavaPrimitiveTypes.int "elbowConnectionSerializedDataVersion" <-- Singleton.nonsingleton.ElbowConnection
	JavaPrimitiveTypes.long "serialVersionUID" <-- Singleton.nonsingleton.ElbowConnection
}
@enduml
