@startuml
package dpd_jdt {
	package Singleton {
		package nonsingleton {
			'@class FileAction
			'@date 08-20-2001
			'@author Eric Crahen
			'@version 1.0Action that provides a smarter JFileChooser
			abstract class FileAction {
				-chooser: SmartChooser
				'Create a new action
				<<Create>> FileAction(name : java.lang.String, icon : javax.swing.Icon)
				'Create a new action
				<<Create>> FileAction(name : java.lang.String)
				'Get the JFileChooser shared among all FileActions
				#getChooser(): SmartChooser
			}
		}
	}
	javax.swing.AbstractAction <|-- Singleton.nonsingleton.FileAction
	java.io.File "lastDirectory" <-- Singleton.nonsingleton.FileAction.SmartChooser
	Singleton.nonsingleton.FileAction.SmartChooser "chooser" <-- Singleton.nonsingleton.FileAction
	java.lang.String "description" <-- Singleton.nonsingleton.FileAction.SimpleFilter
	java.lang.String "extensions 0..*" <-- Singleton.nonsingleton.FileAction.SimpleFilter
}
@enduml
