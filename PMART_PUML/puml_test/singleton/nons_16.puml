@startuml
package dpd_jdt {
	package Holder {
		package nonHolder {
			'The implementation of hierarchy nodes factory for the java loader.
			'@author Petr Hamernik
			class JavaElementNodeFactory {
				-{const} CLASS_ACTIONS: SystemAction [*]
				{const} DEFAULT: DefaultFactory
				-{const} DEFAULT_ACTIONS: SystemAction [*]
				-FACTORY_GETTER_NODE: Node
				-{const} INITIALIZER_ACTIONS: SystemAction [*]
				-tree: JavaPrimitiveTypes.boolean
				'Creates new factory.
				<<Create>> JavaElementNodeFactory()
				#createClassChildren(element : ClassElement): Children
				'Returns the node asociated with specified element.
				'@return ElementNode
				createClassNode(element : ClassElement): Node
				'Returns the node asociated with specified element.
				'@return ElementNode
				createConstructorNode(element : ConstructorElement): Node
				'Returns the node asociated with specified element.
				'@return ElementNode
				createFieldNode(element : FieldElement): Node
				'Returns the node asociated with specified element.
				'@return ElementNode
				createInitializerNode(element : InitializerElement): Node
				'Returns the node asociated with specified element.
				'@return ElementNode
				createMethodNode(element : MethodElement): Node
				'Returns true if generate nodes for tree.
				'@returns true if generate nodes for tree.
				getGenerateForTree(): JavaPrimitiveTypes.boolean
				'If true generate nodes for tree.
				setGenerateForTree(tree : JavaPrimitiveTypes.boolean)
			}
		}
	}
	Holder.nonHolder.DefaultFactory <|-- Holder.nonHolder.JavaElementNodeFactory
	Holder.nonHolder.ElementNodeFactory <|.. Holder.nonHolder.DefaultFactory
	Holder.nonHolder.IconStrings <|-- Holder.nonHolder.DefaultFactory
	Holder.nonHolder.SystemAction "CATEGORY_ACTIONS 0..*" <-- Holder.nonHolder.DefaultFactory
	java.lang.String "CATEGORY_ICONS 0..*" <-- Holder.nonHolder.DefaultFactory
	JavaPrimitiveTypes.int "FILTERS 0..*" <-- Holder.nonHolder.DefaultFactory
	java.lang.String "NAMES 0..*" <-- Holder.nonHolder.DefaultFactory
	java.lang.String "SHORTDESCRS 0..*" <-- Holder.nonHolder.DefaultFactory
	JavaPrimitiveTypes.boolean "writeable" <-- Holder.nonHolder.DefaultFactory
	Holder.nonHolder.ClassElement "element" <-- Holder.nonHolder.DefaultFactory.ElementCategoryNode
	JavaPrimitiveTypes.int "newTypeIndex" <-- Holder.nonHolder.DefaultFactory.ElementCategoryNode
	Holder.nonHolder.SystemAction "CLASS_ACTIONS 0..*" <-- Holder.nonHolder.JavaElementNodeFactory
	Holder.nonHolder.DefaultFactory "DEFAULT" <-- Holder.nonHolder.JavaElementNodeFactory
	Holder.nonHolder.SystemAction "DEFAULT_ACTIONS 0..*" <-- Holder.nonHolder.JavaElementNodeFactory
	Holder.nonHolder.Node "FACTORY_GETTER_NODE" <-- Holder.nonHolder.JavaElementNodeFactory
	Holder.nonHolder.SystemAction "INITIALIZER_ACTIONS 0..*" <-- Holder.nonHolder.JavaElementNodeFactory
	JavaPrimitiveTypes.boolean "tree" <-- Holder.nonHolder.JavaElementNodeFactory
}
@enduml
