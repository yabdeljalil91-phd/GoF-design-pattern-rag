@startuml
package dpd_jdt {
	package Abstractfactory {
		package non_abstract_factory {
			'Factory for all refactorings
			'@author    Chris Seguin
			class RefactoringFactory {
				-fieldFactory: FieldRefactoringFactory
				-methodFactory: MethodRefactoringFactory
				-{static} singleton: RefactoringFactory
				-typeFactory: TypeRefactoringFactory
				'Constructor for the RefactoringFactory object
				#<<Create>> RefactoringFactory()
				'Adds a feature to the Child attribute of the TypeRefactoringFactory object
				'@return    Description of the Returned Value
				addChild(): AddChildRefactoring
				'Adds a feature to the Parent attribute of the TypeRefactoringFactory object
				'@return    Description of the Returned Value
				addParent(): AddAbstractParent
				'Extracts the interface of a class into a new interface object
				'@return    Description of the Returned Value
				extractInterface(): ExtractInterfaceRefactoring
				'Extracts code from one method to create a new method
				'@return    Description of the Returned Value
				extractMethod(): ExtractMethodRefactoring
				'A standard method to get the factory
				'@return    Description of the Returned Value
				{static} get(): RefactoringFactory
				'Initializes the singleton
				-{static} init()
				'Creates a move class refactoring object
				'@return    the move class refactoring object
				moveClass(): MoveClass
				'Moves the method into another class
				'@return    Description of the Returned Value
				moveMethod(): MoveMethodRefactoring
				'Prepare to create a refactoring that operates on files on the disk. This is an IDE's last opportunity to save files before the refactoring is performed. This is not used for ExtractMethod which works on code that is in memory (rather than on the disk)
				#prepare()
				'Moves the field into the parent class
				'@return    Description of the Returned Value
				pushDownField(): PushDownFieldRefactoring
				'Moves the method into a child class
				'@return    Description of the Returned Value
				pushDownMethod(): PushDownMethodRefactoring
				'Moves the method signature into the parent class
				'@return    Description of the Returned Value
				pushUpAbstractMethod(): PushUpAbstractMethodRefactoring
				'Moves the field into the child class
				'@return    Description of the Returned Value
				pushUpField(): PushUpFieldRefactoring
				'Moves the method into the parent class
				'@return    Description of the Returned Value
				pushUpMethod(): PushUpMethodRefactoring
				'Description of the Method
				'@return    Description of the Returned Value
				removeEmptyClass(): RemoveEmptyClassRefactoring
				'Description of the Method
				'@return    Description of the Returned Value
				renameClass(): RenameClassRefactoring
				'Renames a field
				'@return    The refactoring
				renameField(): RenameFieldRefactoring
				'Renames a parameter
				'@return    Description of the Returned Value
				renameParameter(): RenameParameterRefactoring
				'This allows someone to replace this factory
				'@param value  The new Singleton value
				{static} setSingleton(value : RefactoringFactory)
			}
		}
	}
	Abstractfactory.non_abstract_factory.Refactoring <|-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	Abstractfactory.non_abstract_factory.FieldRefactoringFactory "fieldFactory" <-- Abstractfactory.non_abstract_factory.RefactoringFactory
	Abstractfactory.non_abstract_factory.MethodRefactoringFactory "methodFactory" <-- Abstractfactory.non_abstract_factory.RefactoringFactory
	Abstractfactory.non_abstract_factory.TypeRefactoringFactory "typeFactory" <-- Abstractfactory.non_abstract_factory.RefactoringFactory
	JavaPrimitiveTypes.int "PACKAGE" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	JavaPrimitiveTypes.int "PRIVATE" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	JavaPrimitiveTypes.int "PROTECTED" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	JavaPrimitiveTypes.int "PUBLIC" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	java.lang.Object "arguments 0..*" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	Abstractfactory.non_abstract_factory.EMParameterFinder "empf" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	Abstractfactory.non_abstract_factory.FileSummary "extractedMethodFileSummary" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	java.lang.StringBuffer "fullFile" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	Abstractfactory.non_abstract_factory.Node "key" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	Abstractfactory.non_abstract_factory.FileSummary "mainFileSummary" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	java.lang.String "methodName" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	JavaPrimitiveTypes.int "prot" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	java.lang.Object "returnType" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	Abstractfactory.non_abstract_factory.SimpleNode "root" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	java.lang.String "selection" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	java.lang.StringBuffer "signature" <-- Abstractfactory.non_abstract_factory.ExtractMethodRefactoring
	JavaPrimitiveTypes.boolean "isStatement" <-- Abstractfactory.non_abstract_factory.EMBuilder
	JavaPrimitiveTypes.boolean "localVariableNeeded" <-- Abstractfactory.non_abstract_factory.EMBuilder
	java.lang.String "methodName" <-- Abstractfactory.non_abstract_factory.EMBuilder
	java.util.LinkedList "parameters" <-- Abstractfactory.non_abstract_factory.EMBuilder
	Abstractfactory.non_abstract_factory.VariableSummary "returnSummary" <-- Abstractfactory.non_abstract_factory.EMBuilder
}
@enduml
