@startuml
'Design pattern Adapter
package "Netbeans v1.0.x" as Netbeans_v1.0.x {
	package org {
		package openidex {
			package search {
				'/** 
				' * Scanner above a SearchType or set of SearchTypes. Has to have default constructor because it is constructed dynamicly by the search machine for a set of SearchTypes that return the same class of Scanner. <P> After the instance is created the SearchTypes are registered to the Scanner by method add.
				' * @author Jaroslav Tulach
				' */
				'DP role: client
				abstract class Scanner {
					#listener: ScannerListener
					'/** 
					' * All subclasses have to have default constructor.
					' */
					<<Create>> Scanner()
					'/** 
					' * Registers a SearchType to the Scanner. It is guaranteed that the SearchType previously returned this Scanner's class from its scannerClass () method. <P> This method allows a Scanner to obtain data entered by user into SearchType.
					' * @param st the search type
					' * @exception ClassCastException if the kriterium passed isnot the right one (which should never happen)
					' */
					add(st : SearchType)
					'/** 
					' * Adds a listener to things that happen in the scanner. This is a unisource listener.
					' * @param l the listener
					' * @exception TooManyListenersException
					' */
					addScannerListener(l : ScannerListener)
					'/** 
					' * Notify listener about new found nodes.
					' */
					#notifyFound(nodes : Netbeans_v1.0.x.org.openide.nodes.Node)
					'/** 
					' * Removes a listener.
					' * @param l the listener
					' */
					removeScannerListener(l : ScannerListener)
					'/** 
					' * Starts the scan on given array of nodes and notifies the associated listener about found results.
					' * @param nodes nodes to perform scan on
					' */
					scan(nodes : Netbeans_v1.0.x.org.openide.nodes.Node)
				}
				'DP role: target
				'DP role: adaptee
				interface ScannerListener {
					scannerFound(event : ScannerEvent)
				}
				Netbeans_v1.0.x.java.util.EventListener <|-- ScannerListener
				Netbeans_v1.0.x.org.openide.ServiceType <|-- SearchType
				Netbeans_v1.0.x.java.lang.Cloneable <|.. SearchType
				Netbeans_v1.0.x.org.openide.util.Task <|-- SearchTask
				Netbeans_v1.0.x.org.openide.nodes.Node "found 0..*" <-- ScannerEvent
				ScannerListener "listener" <-- Scanner
				Netbeans_v1.0.x.java.lang.String "PROP_VALID" <-- SearchType
				JavaPrimitiveTypes.long "serialVersionUID" <-- SearchType
				JavaPrimitiveTypes.boolean "valid" <-- SearchType
			}
		}
		package openide {
			package nodes {
				'DP role: adaptee
				interface NodeAcceptor {
					acceptNodes(nodes : Node): JavaPrimitiveTypes.boolean
				}
				Netbeans_v1.0.x.java.beans.FeatureDescriptor <|-- Node
				NodeAdapter <|-- ChildrenArray
				NodeListener <|.. NodeAdapter
				Netbeans_v1.0.x.java.beans.PropertyChangeListener <|-- NodeListener
				NodeEvent <|-- NodeMemberEvent
