			JavaPrimitiveTypes.long "serialVersionUID" <-- ServiceType
			Netbeans_v1.0.x.java.beans.PropertyChangeSupport "supp" <-- ServiceType
			Netbeans_v1.0.x.java.lang.String "className" <-- Handle
			Netbeans_v1.0.x.java.lang.String "name" <-- Handle
			JavaPrimitiveTypes.long "serialVersionUID" <-- Handle
			ServiceType "serviceType" <-- Handle
			JavaPrimitiveTypes.long "serialVersionUID" <-- Registry
		}
		package netbeans {
			package modules {
				package search {
					'/** 
					' * Intersect results from more scan tasks. Functionality depends on equals() method of found nodes.
					' * @author  Petr kuzel
					' * @version 1.0
					' */
					'DP role: client
					'DP role: adapter
					class SearchResultIntersection {
						-TRACE: JavaPrimitiveTypes.boolean = false
						-cache: Netbeans_v1.0.x.java.util.HashMap
						-scanners: JavaPrimitiveTypes.int
						-target: Netbeans_v1.0.x.org.openidex.search.ScannerListener
						'/** 
						' * Creates new Composer that notifies target. 
						' */
						<<Create>> SearchResultIntersection(target : Netbeans_v1.0.x.org.openidex.search.ScannerListener, scanTasks : JavaPrimitiveTypes.int)
						'/** 
						' * Is found by all other scanners? depends on associated Integer that match number of matches
						' * @return true if the node was found by all branch scanners
						' */
						-cacheHit(node : Netbeans_v1.0.x.org.openide.nodes.Node): JavaPrimitiveTypes.boolean
						'/** 
						' * Intersect scanner results. All scanners results are test on equality.
						' */
						scannerFound(se : Netbeans_v1.0.x.org.openidex.search.ScannerEvent)
						-t(msg : Netbeans_v1.0.x.java.lang.String)
					}
					Netbeans_v1.0.x.org.openidex.search.ScannerListener <|.. SearchResultIntersection
					Netbeans_v1.0.x.org.openidex.search.SearchTask <|-- SearchTaskImpl
					JavaPrimitiveTypes.boolean "TRACE" <-- SearchResultIntersection
					Netbeans_v1.0.x.java.util.HashMap "cache" <-- SearchResultIntersection
					JavaPrimitiveTypes.int "scanners" <-- SearchResultIntersection
					Netbeans_v1.0.x.org.openidex.search.ScannerListener "target" <-- SearchResultIntersection
					JavaPrimitiveTypes.boolean "TRACE" <-- SearchTaskImpl
					Netbeans_v1.0.x.java.util.Vector "found" <-- SearchTaskImpl
					Netbeans_v1.0.x.java.lang.ThreadGroup "group" <-- SearchTaskImpl
					Netbeans_v1.0.x.org.openide.nodes.NodeAcceptor "na" <-- SearchTaskImpl
					Netbeans_v1.0.x.org.openide.nodes.Node "nodes 0..*" <-- SearchTaskImpl
					JavaPrimitiveTypes.boolean "stop" <-- SearchTaskImpl
					Netbeans_v1.0.x.java.util.Vector "threads" <-- SearchTaskImpl
					Netbeans_v1.0.x.org.openidex.search.SearchType "types 0..*" <-- SearchTaskImpl
					Netbeans_v1.0.x.org.openide.nodes.NodeAcceptor "acceptor" <-- AcceptAdapter
					Netbeans_v1.0.x.org.openide.nodes.Node "nodes 0..*" <-- ScannerThread
				}
			}
		}
	}
}
@enduml
