				Netbeans_v1.0.x.java.lang.String "PROP_PARENT_NODE" <-- Node
				Netbeans_v1.0.x.java.lang.String "PROP_PROPERTY_SETS" <-- Node
				Netbeans_v1.0.x.java.lang.String "PROP_SHORT_DESCRIPTION" <-- Node
				Netbeans_v1.0.x.org.openide.util.Mutex "MUTEX" <-- Children
				Netbeans_v1.0.x.java.lang.ref.Reference "array" <-- Children
				Netbeans_v1.0.x.java.util.Collection "entries" <-- Children
				Netbeans_v1.0.x.java.util.Map "map" <-- Children
				Node "parent" <-- Children
				Entry "entry" <-- Info
				JavaPrimitiveTypes.int "length" <-- Info
				JavaPrimitiveTypes.long "serialVersionUID" <-- NodeEvent
				JavaPrimitiveTypes.boolean "add" <-- NodeMemberEvent
				Node "delta 0..*" <-- NodeMemberEvent
				Node "from 0..*" <-- NodeMemberEvent
				JavaPrimitiveTypes.int "indices 0..*" <-- NodeMemberEvent
				JavaPrimitiveTypes.long "serialVersionUID" <-- NodeMemberEvent
				JavaPrimitiveTypes.int "newIndices 0..*" <-- NodeReorderEvent
				JavaPrimitiveTypes.long "serialVersionUID" <-- NodeReorderEvent
				Children "children" <-- ChildrenArray
				Netbeans_v1.0.x.java.util.WeakHashMap "map" <-- ChildrenArray
				Node "nodes 0..*" <-- ChildrenArray
				Netbeans_v1.0.x.java.util.Collection "nodes" <-- Array
				Entry "nodesEntry" <-- Array
				Node "ARRAY 0..*" <-- Empty
				JavaPrimitiveTypes.boolean "before" <-- Keys
				Netbeans_v1.0.x.java.lang.Object "key" <-- KE
				Netbeans_v1.0.x.java.util.Map "nodes" <-- Map
				Netbeans_v1.0.x.java.lang.Object "key" <-- ME
				Node "node" <-- ME
				Netbeans_v1.0.x.java.util.Comparator "comp" <-- SortedArray
				Netbeans_v1.0.x.java.util.Comparator "comp" <-- SortedMap
				Children "hierarchy" <-- Node
