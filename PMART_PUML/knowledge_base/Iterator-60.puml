			Netbeans_v1.0.x.java.lang.String "PROP_MESSAGE" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.lang.String "PROP_MESSAGE_TYPE" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.lang.String "PROP_OPTIONS" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.lang.String "PROP_OPTION_TYPE" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.lang.String "PROP_TITLE" <-- NotifyDescriptor
