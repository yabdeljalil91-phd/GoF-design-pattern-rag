			JavaPrimitiveTypes.int "WARNING_MESSAGE" <-- NotifyDescriptor
			JavaPrimitiveTypes.int "YES_NO_CANCEL_OPTION" <-- NotifyDescriptor
			JavaPrimitiveTypes.int "YES_NO_OPTION" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.lang.Object "YES_OPTION" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.lang.Object "adOptions 0..*" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.beans.PropertyChangeSupport "changeSupport" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.lang.Object "message" <-- NotifyDescriptor
			JavaPrimitiveTypes.int "messageType" <-- NotifyDescriptor
			JavaPrimitiveTypes.int "optionType" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.lang.Object "options 0..*" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.lang.String "title" <-- NotifyDescriptor
			Netbeans_v1.0.x.java.lang.Object "value" <-- NotifyDescriptor
			JavaPrimitiveTypes.long "serialVersionUID" <-- Exception
			Netbeans_v1.0.x.javax.swing.JTextField "textField" <-- InputLine
			JavaPrimitiveTypes.int "BOTTOM_ALIGN" <-- DialogDescriptor
			JavaPrimitiveTypes.int "DEFAULT_ALIGN" <-- DialogDescriptor
			Netbeans_v1.0.x.java.lang.Object "DEFAULT_CLOSING_OPTIONS 0..*" <-- DialogDescriptor
			Netbeans_v1.0.x.java.lang.String "PROP_BUTTON_LISTENER" <-- DialogDescriptor
			Netbeans_v1.0.x.java.lang.String "PROP_CLOSING_OPTIONS" <-- DialogDescriptor
			Netbeans_v1.0.x.java.lang.String "PROP_HELP_CTX" <-- DialogDescriptor
			Netbeans_v1.0.x.java.lang.String "PROP_MODAL" <-- DialogDescriptor
			Netbeans_v1.0.x.java.lang.String "PROP_OPTIONS_ALIGN" <-- DialogDescriptor
			JavaPrimitiveTypes.int "RIGHT_ALIGN" <-- DialogDescriptor
			Netbeans_v1.0.x.java.awt.event.ActionListener "buttonListener" <-- DialogDescriptor
			Netbeans_v1.0.x.java.lang.Object "closingOptions 0..*" <-- DialogDescriptor
			Netbeans_v1.0.x.org.openide.util.HelpCtx "helpCtx" <-- DialogDescriptor
			JavaPrimitiveTypes.boolean "modal" <-- DialogDescriptor
			JavaPrimitiveTypes.int "optionsAlign" <-- DialogDescriptor
			Netbeans_v1.0.x.java.awt.event.ActionListener "CLOSE_PREVENTER" <-- WizardDescriptor
			Netbeans_v1.0.x.java.lang.Object "FINISH_OPTION" <-- WizardDescriptor
			Netbeans_v1.0.x.java.lang.Object "NEXT_OPTION" <-- WizardDescriptor
			Netbeans_v1.0.x.java.lang.Object "PREVIOUS_OPTION" <-- WizardDescriptor
			Netbeans_v1.0.x.javax.swing.JButton "cancelButton" <-- WizardDescriptor
			Panel "current" <-- WizardDescriptor
			Netbeans_v1.0.x.javax.swing.JButton "finishButton" <-- WizardDescriptor
			Listener "listener" <-- WizardDescriptor
			Netbeans_v1.0.x.javax.swing.JButton "nextButton" <-- WizardDescriptor
			Iterator "panels" <-- WizardDescriptor
			Netbeans_v1.0.x.javax.swing.JButton "previousButton" <-- WizardDescriptor
