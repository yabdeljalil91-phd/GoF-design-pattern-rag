			'/** 
			' * @class LinkTool 
			' * @date 08-20-2001
			' * @author Eric Crahen
			' * @version 1.0This tool allows a Link to be added to a Diagram model. The Link must be anchored in a (non-Link) Figure and its sink will be at the current mouse position until it can be placed into another (non-Link) Figure
			' */
			'DP role: leaf
			class LinkTool {
				-{const} POINT_SIZE: JavaPrimitiveTypes.double = 5.0
				-diagram: QuickUML_2001.diagram.Diagram
				-figSink: QuickUML_2001.diagram.Figure
				-figSource: QuickUML_2001.diagram.Figure
				-link: QuickUML_2001.diagram.Link
				-mouseHandler: MouseHandler
				-ptCenter: QuickUML_2001.java.awt.geom.Point2D
				-ptSink: QuickUML_2001.diagram.figures.PointFigure
				<<Create>> LinkTool()
