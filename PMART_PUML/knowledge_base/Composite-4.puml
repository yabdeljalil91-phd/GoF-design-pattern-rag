	package diagram {
		package tool {
			'DP role: component
			interface Tool {
				addToolListener(l : ToolListener)
				install(diagram : QuickUML_2001.diagram.Diagram)
				removeToolListener(l : ToolListener)
				uninstall(diagram : QuickUML_2001.diagram.Diagram)
			}
			'/** 
			' * @class CompositeTool
			' * @date 08-20-2001
			' * @author Eric Crahen
			' * @version 1.0This tool allows composites of other tools to be formed. This is convient  for tools that need to be able to drag AND select, or edit AND select, etc.
			' */
			'DP role: composite
			class CompositeTool {
				-tools: QuickUML_2001.java.util.Vector
				<<Create>> CompositeTool()
				add(tool : Tool)
				'/** 
				' * Add a new listener to this tool.
				' * @param ToolListener
				' */
				addToolListener(l : ToolListener)
				install(diagram : QuickUML_2001.diagram.Diagram)
				remove(tool : Tool)
				'/** 
				' * Remove a listener to this tool.
				' * @param ToolListener
				' */
				removeToolListener(l : ToolListener)
				uninstall(diagram : QuickUML_2001.diagram.Diagram)
			}
			'/** 
			' * @class ClipboardTool
			' * @date 08-20-2001
			' * @author Eric Crahen
			' * @version 1.0A Clipboard implements the copy/cut/paste actions for a Diagram. A set of actions are inserted into the target Diagrams ActionMap (copy, cut, and paste) that allow the UI to map inputs to these actions as it sees fit.
			' */
			'DP role: leaf
			class ClipboardTool {
				#actionCopy: QuickUML_2001.javax.swing.Action
				#actionCut: QuickUML_2001.javax.swing.Action
				#actionPaste: QuickUML_2001.javax.swing.Action
				-clipboard: QuickUML_2001.java.util.ArrayList
				-copyboard: QuickUML_2001.java.util.ArrayList
				#{static} diagramKey: QuickUML_2001.java.lang.ThreadLocal
				-figures: QuickUML_2001.diagram.Figure [*]
				-related: QuickUML_2001.diagram.Figure [*]
				<<Create>> ClipboardTool()
				'/** 
				' * Copy the current selection from the Diagram to the Clipboard
				' */
				doCopy()
				'/** 
				' * Cut the current selection from the Diagram
				' */
				doCut()
				'/** 
				' * Paste the top of the clipboard stack to the diagram
				' */
				doPaste()
				'/** 
				' */
				-doPaste(figure : QuickUML_2001.diagram.Figure, model : QuickUML_2001.diagram.DiagramModel, selectionModel : QuickUML_2001.diagram.SelectionModel, ui : QuickUML_2001.diagram.DiagramUI)
				'/** 
				' * Get the diagram the Clipboard is configured for
				' * @return Diagram
				' */
				{static} getDiagram(): QuickUML_2001.diagram.Diagram
				'/** 
				' * Install the support in the specified Diagram
				' * @param Diagram
				' */
				install(diagram : QuickUML_2001.diagram.Diagram)
				'/** 
				' * Prepare for a clipboard operation. Copy the current selection into a local array for processing.
				' * @return boolean
				' */
				#prepareSelection(): JavaPrimitiveTypes.boolean
				'/** 
				' * Configure the current context for the given Diagram
				' * @param Diagram
				' * @return Clipboard
				' */
				{static} setDiagram(diagram : QuickUML_2001.diagram.Diagram)
				'/** 
				' * Install the support in the specified Diagram
				' * @param Diagram
				' */
				uninstall(diagram : QuickUML_2001.diagram.Diagram)
			}
			'/** 
			' * @class EditingTool
			' * @date 08-20-2001
			' * @author Eric Crahen
			' * @version 1.0Add figure editing support to a Diagram. The method used to supprot figure  editing is a simplified version of the method used in Suns JTable  implementation. Editing is triggered whenever a mouse is clicked inside a Figure in a  Diagram. The FigureEditor for the diagram is obtained and an Component is  produced to perform the editing. Editing will continue until that Component loses focus, either from clicking off or clicking onto another Figure. Three Action objects are installed in the Diagram ActionMap,  "startEditing" "stopEditing" "cancleEditing" A diagram can insert mapping for these actions into its InputMap inorder to take advantage of them. Editing can be controlled programtically, on the selected Figure, in this way.
			' */
			'DP role: leaf
			class EditingTool {
				#actionCancel: QuickUML_2001.javax.swing.Action
				#actionStart: QuickUML_2001.javax.swing.Action
				#actionStop: QuickUML_2001.javax.swing.Action
				-diagram: QuickUML_2001.diagram.Diagram
				-dispatchComponent: QuickUML_2001.java.awt.Component
				-editor: QuickUML_2001.diagram.FigureEditor
				-editorBounds: QuickUML_2001.java.awt.Rectangle
				-editorComponent: QuickUML_2001.java.awt.Component
				-figure: QuickUML_2001.diagram.Figure
				#focusHandler: FocusHandler
				#mouseHandler: MouseHandler
				-selected: QuickUML_2001.diagram.Figure [*]
				<<Create>> EditingTool()
				'/** 
				' * Install the support in the specified Diagram
				' * @param Diagram
				' */
				install(diagram : QuickUML_2001.diagram.Diagram)
				'/** 
				' * Check if this support object is currently editing a diagram.
				' * @return boolean
				' */
				#isEditing(): JavaPrimitiveTypes.boolean
				'/** 
				' * Remove the editing component
				' * @post Clears any reference to the editing components no longerin use.
				' */
				#removeEditor()
				'/** 
				' * Try to start editing a Figure
				' * @param Diagram
				' * @param Figure
				' * @param EventObject
				' * @return boolean true if editing was successfully started.
				' */
				#startEditing(diagram : QuickUML_2001.diagram.Diagram, figure : QuickUML_2001.diagram.Figure, e : QuickUML_2001.java.util.EventObject): JavaPrimitiveTypes.boolean
				'/** 
				' * Stop editing a certain figure
				' */
				#stopEditing(diagram : QuickUML_2001.diagram.Diagram, figure : QuickUML_2001.diagram.Figure)
				'/** 
				' * Uninstall the support from the specified Diagram
				' * @param Diagram
				' */
				uninstall(diagram : QuickUML_2001.diagram.Diagram)
			}
			'/** 
			' * @class FigureDraggingTool
			' * @date 08-20-2001
			' * @author Eric Crahen
			' * @version 1.0This tool allows selected Figures to be dragged around the Diagram.
			' */
			'DP role: leaf
			class FigureDraggingTool {
				-{const} MV_CURSOR: QuickUML_2001.java.awt.Cursor
				-diagram: QuickUML_2001.diagram.Diagram
				-dragPoint: QuickUML_2001.java.awt.geom.Point2D
				-mouseHandler: MouseHandler
				-originalCursor: QuickUML_2001.java.awt.Cursor
				#relatedFigures: QuickUML_2001.diagram.Figure [*]
				-relatedList: QuickUML_2001.java.util.ArrayList
				#selectedFigures: QuickUML_2001.diagram.Figure [*]
				<<Create>> FigureDraggingTool()
				'/** 
				' * Find all the related figures, update the relatedFigures array.
				' */
				#getRelatedFigures()
				'/** 
				' * Install support for something in the given Diagram
				' * @param Diagram
				' */
				install(diagram : QuickUML_2001.diagram.Diagram)
				'/** 
				' * Cleanup
				' */
				#reset()
				'/** 
				' * Remove support for something that was previously installed.
				' * @param Diagram
				' */
				uninstall(diagram : QuickUML_2001.diagram.Diagram)
			}
			'/** 
			' * @class FigureShapping
			' * @date 08-20-2001
			' * @author Eric Crahen
			' * @version 1.0Add node shaping support to a Diagram.
			' */
			'DP role: leaf
			class FigureShappingTool {
				-{const} HZ_CURSOR: QuickUML_2001.java.awt.Cursor
				-{const} MINIMUM_SIZE: JavaPrimitiveTypes.int = 16
				-{const} QUAD_BOTTOM: JavaPrimitiveTypes.int = 1024
				-{const} QUAD_CENTER: JavaPrimitiveTypes.int = 512
				-{const} QUAD_LEFT: JavaPrimitiveTypes.int = 1
				-{const} QUAD_MIDDLE: JavaPrimitiveTypes.int = 2
				-{const} QUAD_RIGHT: JavaPrimitiveTypes.int = 4
				-{const} QUAD_TOP: JavaPrimitiveTypes.int = 256
				-{const} SENW_CURSOR: QuickUML_2001.java.awt.Cursor
				-{const} SWNE_CURSOR: QuickUML_2001.java.awt.Cursor
				-{const} VT_CURSOR: QuickUML_2001.java.awt.Cursor
				-bounds: QuickUML_2001.java.awt.geom.Rectangle2D
				-center: QuickUML_2001.java.awt.geom.Point2D
				-diagram: QuickUML_2001.diagram.Diagram
				-dragPoint: QuickUML_2001.java.awt.geom.Point2D
				-figure: QuickUML_2001.diagram.Figure
				-graphics: QuickUML_2001.java.awt.Graphics2D
				-lastPoint: QuickUML_2001.java.awt.geom.Point2D
				-mouseHandler: MouseHandler
				-originalCursor: QuickUML_2001.java.awt.Cursor
				-outline: QuickUML_2001.java.awt.geom.Rectangle2D.Double
				#relatedFigures: QuickUML_2001.diagram.Figure [*]
				-sizingDirection: JavaPrimitiveTypes.int
				<<Create>> FigureShappingTool()
				'/** 
				' * Guess the right cursor to use based on some point in the Figure
				' * @return Cursor
				' */
				-getCursor(): QuickUML_2001.java.awt.Cursor
				'/** 
				' * Prepare the graphcis context.
				' * @return Graphics2D
				' */
				-getGraphics(c : QuickUML_2001.java.awt.Component): QuickUML_2001.java.awt.Graphics2D
				'/** 
				' * Find the direction using the clicked point & the center of  the target Figure. 
				' * @param Point2D clicked point
				' */
				-getQuadrant(pt : QuickUML_2001.java.awt.geom.Point2D)
				'/** 
				' * Test the quadrant flag
				' * @return boolean
				' */
				-hasQuad(quad : JavaPrimitiveTypes.int): JavaPrimitiveTypes.boolean
				'/** 
				' * Install the support in the specified Diagram
				' * @param Diagram
				' */
				install(diagram : QuickUML_2001.diagram.Diagram)
				'/** 
				' * Paint the resizing outline of the Figure.
				' * @param dx - position change
				' * @param dy - position change
				' * @param boolean true if only need to erase last drawn outline
				' */
				-paintOutline(dx : JavaPrimitiveTypes.double, dy : JavaPrimitiveTypes.double, eraseOnly : JavaPrimitiveTypes.boolean)
				#reset()
				'/** 
				' * Reshape the drag outline.
				' * @param double
				' * @param double
				' */
				-reshapeOutline(dx : JavaPrimitiveTypes.double, dy : JavaPrimitiveTypes.double)
				'/** 
				' * Uninstall the support from specified Diagram
				' * @param Diagram
				' */
				uninstall(diagram : QuickUML_2001.diagram.Diagram)
			}
			'/** 
			' * @class FigureTool 
			' * @date 08-20-2001
			' * @author Eric Crahen
			' * @version 1.0This tool allows a Figure to be added to a Diagram model. The FigureTool will accept an instance of a Figure to use as a protoype. Each time the tool is invoked, the prototype is clone()ed and shaped to the correct size. If the user does not drag the mouse to shape the cloned Figure then it is set to the default size suplpied by prototype object.
			' */
			'DP role: leaf
			class FigureTool {
				-current: QuickUML_2001.diagram.Figure
				-diagram: QuickUML_2001.diagram.Diagram
				-fig: QuickUML_2001.diagram.Figure
				-mouseHandler: MouseHandler
				-ptPress: QuickUML_2001.java.awt.geom.Point2D
				-rcBounds: QuickUML_2001.java.awt.geom.Rectangle2D
				'/** 
				' * Create a figure tool that uses the given Figure as a template. 
				' * @param Figure
				' */
				<<Create>> FigureTool(fig : QuickUML_2001.diagram.Figure)
				'/** 
				' * Install support for something in the given Diagram
				' * @param Diagram
				' */
				install(diagram : QuickUML_2001.diagram.Diagram)
				'/** 
				' * Cleanup
				' */
				#reset()
				'/** 
				' * Remove support for something that was previously installed.
				' * @param Diagram
				' */
				uninstall(diagram : QuickUML_2001.diagram.Diagram)
				'/** 
				' * Calculate a bounding rectangle between two arbitrary points
				' * @param Point2D pt1
				' * @param Point2D pt2
				' */
				#updateBounds(pt1 : QuickUML_2001.java.awt.geom.Point2D, pt2 : QuickUML_2001.java.awt.geom.Point2D)
			}
			'/** 
			' * @class LinkShapping
			' * @date 08-20-2001
			' * @author Eric Crahen
			' * @version 1.0This tool allows PolyLink figures to be dragged or edited. Left-clicking and dragging allows new points to be inserted into the PolyLink, or existing points to be moved. Right-clicking allows existing points to be deleted. The two end points are immune to these operations.
			' */
			'DP role: leaf
			class LinkShappingTool {
				{const} CLICK_TOLERANCE: JavaPrimitiveTypes.double = 6.0
				{const} DRAG_TOLERANCE: JavaPrimitiveTypes.double = 6.0
				-{const} HD_CURSOR: QuickUML_2001.java.awt.Cursor
				-diagram: QuickUML_2001.diagram.Diagram
				-dragPoint: QuickUML_2001.java.awt.geom.Point2D
				-mouseHandler: MouseHandler
				-originalCursor: QuickUML_2001.java.awt.Cursor
				-polyLink: QuickUML_2001.diagram.figures.PolyLink
				-pressPoint: QuickUML_2001.java.awt.geom.Point2D
				<<Create>> LinkShappingTool()
				'/** 
				' * Install the support in the specified Diagram
				' * @param Diagram
				' */
				install(diagram : QuickUML_2001.diagram.Diagram)
				'/** 
				' * Called when a link has been clicked
				' */
				#linkClicked(link : QuickUML_2001.diagram.figures.PolyLink, event : QuickUML_2001.java.awt.event.MouseEvent)
				'/** 
				' * Called when a link has been pressed
				' */
				#linkPressed(link : QuickUML_2001.diagram.figures.PolyLink, event : QuickUML_2001.java.awt.event.MouseEvent)
				'/** 
				' * Called when a link has been pressed
				' */
				#linkReleased(link : QuickUML_2001.diagram.figures.PolyLink, event : QuickUML_2001.java.awt.event.MouseEvent)
				'/** 
				' * Clean up
				' */
