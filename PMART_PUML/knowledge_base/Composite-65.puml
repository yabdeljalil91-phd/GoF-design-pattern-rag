			' * A <code>TestSuite</code> is a <code>Composite</code> of Tests. It runs a collection of test cases. Here is an example using the dynamic test definition. <pre> TestSuite suite= new TestSuite(); suite.addTest(new MathTest("testAdd")); suite.addTest(new MathTest("testDivideByZero")); </pre> Alternatively, a TestSuite can extract the tests to be run automatically. To do so you pass the class of your TestCase class to the TestSuite constructor. <pre> TestSuite suite= new TestSuite(MathTest.class); </pre> This constructor creates a suite with all the methods starting with "test" that take no arguments.
			' * @see Test
			' */
			'DP role: composite
			class TestSuite {
				-fName: JUnit_v3.7.java.lang.String
				-fTests: JUnit_v3.7.java.util.Vector
				'/** 
				' * Constructs an empty TestSuite.
				' */
				<<Create>> TestSuite()
				'/** 
				' * Constructs a TestSuite from the given class. Adds all the methods starting with "test" as test cases to the suite. Parts of this method was written at 2337 meters in the H�ffih�tte, Kanton Uri
				' */
				<<Create>> TestSuite(theClass : JUnit_v3.7.java.lang.Class)
				'/** 
				' * Constructs an empty TestSuite.
				' */
				<<Create>> TestSuite(name : JUnit_v3.7.java.lang.String)
				'/** 
				' * Adds a test to the suite.
				' */
				addTest(test : Test)
				-addTestMethod(m : JUnit_v3.7.java.lang.reflect.Method, names : JUnit_v3.7.java.util.Vector, constructor : JUnit_v3.7.java.lang.reflect.Constructor)
				'/** 
				' * Adds the tests from the given class to the suite
				' */
				addTestSuite(testClass : JUnit_v3.7.java.lang.Class)
				'/** 
				' * Counts the number of test cases that will be run by this test.
				' */
				countTestCases(): JavaPrimitiveTypes.int
				'/** 
				' * Converts the stack trace into a string
				' */
				-exceptionToString(t : JUnit_v3.7.java.lang.Throwable): JUnit_v3.7.java.lang.String
				'/** 
				' * Gets a constructor which takes a single String as its argument.
				' */
				-getConstructor(theClass : JUnit_v3.7.java.lang.Class): JUnit_v3.7.java.lang.reflect.Constructor
				'/** 
				' * Returns the name of the suite. Not all test suites have a name and this method can return null.
				' */
				getName(): JUnit_v3.7.java.lang.String
				'/** 
				' */
				-isPublicTestMethod(m : JUnit_v3.7.java.lang.reflect.Method): JavaPrimitiveTypes.boolean
				'/** 
				' */
				-isTestMethod(m : JUnit_v3.7.java.lang.reflect.Method): JavaPrimitiveTypes.boolean
				'/** 
				' * Runs the tests and collects their result in a TestResult.
				' */
				run(result : TestResult)
				runTest(test : Test, result : TestResult)
				'/** 
				' * Sets the name of the suite.
				' * @param name The name to set
				' */
				setName(name : JUnit_v3.7.java.lang.String)
				'/** 
				' * Returns the test at the given index 
				' */
				testAt(index : JavaPrimitiveTypes.int): Test
				'/** 
				' * Returns the number of tests in this suite 
				' */
				testCount(): JavaPrimitiveTypes.int
				'/** 
				' * Returns the tests as an enumeration
				' */
				tests(): JUnit_v3.7.java.util.Enumeration
				'/** 
				' */
				toString(): JUnit_v3.7.java.lang.String
				'/** 
				' * Returns a test which will fail and log a warning message.
				' */
				-warning(message : JUnit_v3.7.java.lang.String): Test
			}
