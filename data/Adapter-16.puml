							load(init : JRefactory_v2.6.24.org.acm.seguin.summary.PackageSummary)

							{static} main(args : JRefactory_v2.6.24.java.lang.String)
						}

						'========================
						' ADAPTER
						'========================
						class JumpToTypeAdapter {
							' DP role: Adapter
							' Responsibility: Translates mouse events into navigation calls on UMLPackage (Adaptee)
							-typeSummary: JRefactory_v2.6.24.org.acm.seguin.summary.TypeSummary
