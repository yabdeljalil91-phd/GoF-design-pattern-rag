							' Key adaptation: mouse event -> umlPackage.jumpTo(type)
							mouseClicked(e : JRefactory_v2.6.24.java.awt.event.MouseEvent)
						}

						'========================
						' TARGET RELATION
						'========================
						JRefactory_v2.6.24.java.awt.event.MouseAdapter <|-- JumpToTypeAdapter : inherits Target adapter class (event handling)

						'========================
						' ASSOCIATIONS / DELEGATION
						'========================
						JRefactory_v2.6.24.org.acm.seguin.summary.PackageSummary "summary" <-- ClassListPanel
						JRefactory_v2.6.24.org.acm.seguin.uml.UMLPackage "umlPackage" <-- ClassListPanel : client uses Adaptee

						JRefactory_v2.6.24.org.acm.seguin.summary.TypeSummary "typeSummary" <-- JumpToTypeAdapter
						JRefactory_v2.6.24.org.acm.seguin.uml.UMLPackage "umlPackage" <-- JumpToTypeAdapter : delegates to Adaptee

						JRefactory_v2.6.24.javax.swing.JPanel <|-- ClassListPanel : UI specialization

					}
				}

