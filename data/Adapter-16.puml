						drop()

						#find(id : JRefactory_v2.6.24.java.lang.String): UMLType
						#find(panel1 : JRefactory_v2.6.24.java.lang.String, panel2 : JRefactory_v2.6.24.java.lang.String): JRefactory_v2.6.24.org.acm.seguin.uml.line.SegmentedLine
						#findType(searching : JRefactory_v2.6.24.org.acm.seguin.summary.TypeSummary): UMLType

						getFile(): JRefactory_v2.6.24.java.io.File
						getMinimumSize(): JRefactory_v2.6.24.java.awt.Dimension
						getPackageName(): JRefactory_v2.6.24.java.lang.String
						getPreferredSize(): JRefactory_v2.6.24.java.awt.Dimension
						getSummary(): JRefactory_v2.6.24.org.acm.seguin.summary.PackageSummary
						getTitle(): JRefactory_v2.6.24.java.lang.String
						getTypes(): UMLType

						hit(actual : JRefactory_v2.6.24.java.awt.Point)

						isDirty(): JavaPrimitiveTypes.boolean

						' Core behavior used by Adapter
						jumpTo(type : JRefactory_v2.6.24.org.acm.seguin.summary.TypeSummary)

						paint(g : JRefactory_v2.6.24.java.awt.Graphics)
						print(g : JRefactory_v2.6.24.java.awt.Graphics, x : JavaPrimitiveTypes.int, y : JavaPrimitiveTypes.int)

						reload()
						removeAssociation(field : UMLField)
						-reset()
						save()

						setClassListPanel(value : JRefactory_v2.6.24.org.acm.seguin.ide.common.ClassListPanel)
						setDirty()
						setLoading(value : JavaPrimitiveTypes.boolean)
						setScrollPane(value : JRefactory_v2.6.24.javax.swing.JScrollPane)
