					'========================
					' INHERITANCE / INTERFACES
					'========================
					JRefactory_v2.6.24.org.acm.seguin.uml.line.LinedPanel <|-- UMLPackage : adaptee specialization
					JRefactory_v2.6.24.org.acm.seguin.io.Saveable <|.. UMLPackage : interface implementation

					'========================
					' KEY ASSOCIATION
					'========================
					JRefactory_v2.6.24.org.acm.seguin.ide.common.ClassListPanel "classListPanel" <-- UMLPackage

					' (Other structural details preserved as-is)
