						-summary: JRefactory_v2.6.24.org.acm.seguin.summary.PackageSummary

						<<Create>> UMLPackage(packageSummary : JRefactory_v2.6.24.org.acm.seguin.summary.PackageSummary)
						<<Create>> UMLPackage(filename : JRefactory_v2.6.24.java.lang.String)
