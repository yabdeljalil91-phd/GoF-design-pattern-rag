@startuml
' Singleton class UML for NullWritable (Nutch v0.4)
' Enhanced for RAG + GoF classification (Flyweight-like Singleton + Null Object pattern)

package "10 - Nutch v0.4" as Nutch {

    class NullWritable {

        '====================================================
        ' SINGLETON STATE (unique canonical instance)
        '====================================================
        - {const} THIS: NullWritable

        '====================================================
        ' CONSTRUCTION CONTROL
        '====================================================
        ' Private constructor prevents external instantiation
        - <<Create>> NullWritable()

        '====================================================
        ' SINGLETON ACCESSOR
        '====================================================
        {static} get(): NullWritable

        '====================================================
        ' SERIALIZATION CONTRACT (Writable interface behavior)
        '====================================================
        readFields(in: java.io.DataInput)
        write(out: java.io.DataOutput)
    }

    '========================================================
    ' TYPE HIERARCHY
    '========================================================
    Writable <|.. NullWritable

    '========================================================
    ' RAG-ORIENTED DESIGN PATTERN INTERPRETATION
    '========================================================
    '
    ' Primary pattern: Singleton (canonical immutable instance)
    ' Secondary pattern: Null Object Pattern (GoF behavioral pattern)
    '
    '========================================================
    ' STRUCTURAL SIGNALS (Singleton evidence)
    '========================================================
    ' - static constant instance: THIS
    ' - private constructor: prevents external instantiation
    ' - static accessor: get()
    '
    '========================================================
    ' BEHAVIORAL SEMANTICS (important distinction)
    '========================================================
    ' - Implements Writable but represents "absence of value"
    ' - readFields/write are no-op or identity-like serialization
    '
    '========================================================
    ' ARCHITECTURAL CLASSIFICATION
    '========================================================
    ' Pattern composition:
    '   Singleton + Null Object Pattern
    '
    ' Important nuance:
    '   This is NOT a typical stateful Singleton
    '   → It is an immutable canonical sentinel object
    '
}
@enduml