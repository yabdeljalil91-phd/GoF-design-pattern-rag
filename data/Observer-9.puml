@startuml
'Design pattern Observer (enhanced for RAG detection)

package "Lexi v0.1.1 alpha" as Lexi_v0.1.1_alpha {
	package com {
		package jmonkey {
			package office {
				package lexi {
					package support {
						package editors {

							'==================== CONCRETE SUBJECT ====================
							'DP role: ConcreteSubject (Observer Pattern)
							'Responsibility: concrete editor that manages state changes and UI events
							class HTMLEditor {
								{const} CONTENT_TYPE: Lexi_v0.1.1_alpha.java.lang.String
								{const} FILE_EXTENSIONS: Lexi_v0.1.1_alpha.java.lang.String [*]

								' Internal state (observed state)
								-_CHANGED: JavaPrimitiveTypes.boolean
								-_CURRENT_PARAGRAPH: Lexi_v0.1.1_alpha.javax.swing.text.Element
								-_CURRENT_RUN: Lexi_v0.1.1_alpha.javax.swing.text.Element

								' UI component (event source)
								-_EDITOR: Lexi_v0.1.1_alpha.javax.swing.JTextPane

								' Delegation to event handler (Observer bridge)
								-_EVENT_LISTENER: E

								-_FILE: Lexi_v0.1.1_alpha.java.io.File

								<<Create>> HTMLEditor()

								'==================== STATE CHANGE METHODS ====================
								' These methods potentially trigger observer notifications
								setChanged(changed : JavaPrimitiveTypes.boolean)
								setCurrentParagraph(paragraph : Lexi_v0.1.1_alpha.javax.swing.text.Element)
								setCurrentRun(run : Lexi_v0.1.1_alpha.javax.swing.text.Element)

								'==================== EVENT HANDLING (delegation to observers) ====================
								keyPressed(kp : Lexi_v0.1.1_alpha.java.awt.event.KeyEvent)
								keyReleased(kr : Lexi_v0.1.1_alpha.java.awt.event.KeyEvent)
								keyTyped(kt : Lexi_v0.1.1_alpha.java.awt.event.KeyEvent)
								mouseClicked(e : Lexi_v0.1.1_alpha.java.awt.event.MouseEvent)
								mousePressed(e : Lexi_v0.1.1_alpha.java.awt.event.MouseEvent)
								mouseReleased(e : Lexi_v0.1.1_alpha.java.awt.event.MouseEvent)

								'==================== OBSERVER CALLBACK HOOKS ====================
								hasBeenActivated(editor : Lexi_v0.1.1_alpha.com.jmonkey.office.lexi.support.Editor)
								hasBeenDeactivated(editor : Lexi_v0.1.1_alpha.com.jmonkey.office.lexi.support.Editor)

								' Other responsibilities omitted for clarity
							}

							'==================== INHERITANCE ====================
							' Generalization: ConcreteSubject extends Subject
							Lexi_v0.1.1_alpha.com.jmonkey.office.lexi.support.Editor <|-- HTMLEditor : extends >

							'==================== OBSERVER INTERFACES ====================
							' HTMLEditor acts as listener to lower-level UI events
							Lexi_v0.1.1_alpha.java.awt.event.MouseListener <|.. HTMLEditor : observes >
							Lexi_v0.1.1_alpha.java.awt.event.KeyListener <|.. HTMLEditor : observes >

							'==================== AGGREGATION / DELEGATION ====================
							' Delegation: editor forwards events to helper listener (observer mediator)
							E "_EVENT_LISTENER" <-- HTMLEditor : delegates events >

							' Back reference (possible bidirectional association)
							HTMLEditor "_PARENT" <-- E : references subject >

						}

						'==================== SUBJECT ====================
						'DP role: Subject (Observer Pattern)
						'Responsibility: defines common editor behavior and lifecycle notifications
						abstract class Editor {

							{const} VALID_CONTENT_TYPES: Lexi_v0.1.1_alpha.java.lang.String [*]

							' Core state
							-_FILE: Lexi_v0.1.1_alpha.java.io.File

							' Supporting components (aggregation)
							-_OPTION_REGISTRY: Lexi_v0.1.1_alpha.com.jmonkey.export.Registry
							#_POPUP_LISTENER: Lexi_v0.1.1_alpha.java.awt.event.ActionListener
							-_UNDO_MANAGER: Lexi_v0.1.1_alpha.javax.swing.undo.UndoManager

							<<Create>> Editor()

							'==================== LIFECYCLE EVENTS ====================
							' These act as implicit notification triggers
							activate()
							deactivate()

							'==================== OBSERVER HOOK METHODS ====================
							' These methods allow observers to react to state changes
							hasBeenActivated(editor : Editor)
							hasBeenDeactivated(editor : Editor)

							'==================== FACTORY-LIKE METHODS ====================
							'Potential Factory Method pattern (secondary pattern signal)
							{const} getEditorForContentType(contentType : Lexi_v0.1.1_alpha.java.lang.String): Editor
							{const} getEditorForExtension(extension : Lexi_v0.1.1_alpha.java.lang.String): Editor

							'==================== STATE MANAGEMENT ====================
							setChanged(changed : JavaPrimitiveTypes.boolean)
							setCurrentParagraph(paragraph : Lexi_v0.1.1_alpha.javax.swing.text.Element)
							setCurrentRun(run : Lexi_v0.1.1_alpha.javax.swing.text.Element)
							setFile(file : Lexi_v0.1.1_alpha.java.io.File)
						}

						'==================== INHERITANCE ====================
						Lexi_v0.1.1_alpha.javax.swing.JPanel <|-- Editor : extends >

						'==================== AGGREGATION ====================
						' Editor aggregates supporting services (not observers directly but part of ecosystem)
						Lexi_v0.1.1_alpha.com.jmonkey.export.Registry "_OPTION_REGISTRY" <-- Editor : aggregates >
						Lexi_v0.1.1_alpha.javax.swing.undo.UndoManager "_UNDO_MANAGER" <-- Editor : aggregates >
						Lexi_v0.1.1_alpha.java.awt.event.ActionListener "_POPUP_LISTENER" <-- Editor : uses >

					}
				}
			}
		}
	}

	'==================== OBSERVER INTERFACES (EXTERNAL) ====================
	package javax {
		package swing {
			package event {

				'DP role: Observer interfaces (Observer Pattern participants)
				interface DocumentListener {
				}
				interface UndoableEditListener {
				}
				interface HyperlinkListener {
				}
				interface ChangeListener {
				}
			}
		}
	}

	package java {
		package awt {
			package event {
				'DP role: Observer
				interface FocusListener {
				}
			}
		}
		package beans {
			'DP role: Observer
			interface VetoableChangeListener {
			}
		}
	}

@enduml