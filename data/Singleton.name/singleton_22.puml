@startuml
package dpd_jdt {
	package Singleton {
		package name {
			'A temporary replacement for a global clipboard. It is a singleton that can be used to store and get the contents of the clipboard.
			class Clipboard {
				-fContents: java.lang.Object
				{static} fgClipboard: Clipboard
				-<<Create>> Clipboard()
				'Gets the clipboard.
				{static} getClipboard(): Clipboard
				'Gets the contents of the clipboard.
				getContents(): java.lang.Object
				'Sets the contents of the clipboard.
				setContents(contents : java.lang.Object)
			}
		}
	}
	java.lang.Object "fContents" <-- Singleton.name.Clipboard
}
@enduml
