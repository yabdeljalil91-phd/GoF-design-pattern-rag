@startuml
package dpd_jdt {
	package Singleton {
		package name {
			'Debug is a singleton with static methods to log information.  Debug is proxy to the actual logging class.  You use Debug with any logging system by implementing a LoggerAdapter for the target system.  You can then assign that loggin system to this Debug by using the setLoggerAdapter method.  By default Debug will create its own SimpleLogger which outputs to the err device.
			'@author Marty Phelan
			'@version 1.0
			'@see SimpleLogger
			class Debug {
				{const} DEBUG: JavaPrimitiveTypes.int = 4
				{const} ERROR: JavaPrimitiveTypes.int = 1
				{const} FATAL: JavaPrimitiveTypes.int = 0
				{const} INFO: JavaPrimitiveTypes.int = 3
				{const} LEVEL_NAMES: java.lang.String [*]
				{const} WARN: JavaPrimitiveTypes.int = 2
				-loggerAdapter: LoggerAdapter
				-{static} singleton: Debug
				'Private constructor to prevent direct instantiation
				-<<Create>> Debug()
				'Writes the given DEBUG message to the log if the DEBUG logging level is enabled
				'@param message is an object which contains the message to log
				{static} debug(message : java.lang.Object)
				'Writes the given DEBUG message and stack trace to the log if the DEBUG logging level is enabled
				'@param message is an object which contains the message to log
				'@param t throwable to be rendered using printStackTrace
				{static} debug(message : java.lang.Object, t : java.lang.Throwable)
				'Writes the given ERROR message to the log if the ERROR logging level is enabled
				'@param message is an object which contains the message to log
				{static} error(message : java.lang.Object)
				'Writes the given ERROR message and stack trace to the log if the ERROR logging level is enabled
				'@param message is an object which contains the message to log
				'@param t throwable to be rendered using printStackTrace
				{static} error(message : java.lang.Object, t : java.lang.Throwable)
				'Writes the given FATAL message to the log if the FATAL logging level is enabled
				'@param message is an object which contains the message to log
				{static} fatal(message : java.lang.Object)
				'Writes the given FATAL message and stack trace to the log if the FATAL logging level is enabled
				'@param message is an object which contains the message to log
				'@param t throwable to be rendered using printStackTrace
				{static} fatal(message : java.lang.Object, t : java.lang.Throwable)
				'Returns the singleton Debug instance.
				'@return singleton Debug instance.
				{static} getInstance(): Debug
				'Gets the LoggerAdapter used by the singleton Debug.
				'@return loggerAdapter to by used by the singleton Debug.
				{static} getLoggerAdapter(): LoggerAdapter
				'Writes the given INFO message to the log if the INFO logging level is enabled
				'@param message is an object which contains the message to log
				{static} info(message : java.lang.Object)
				'Writes the given INFO message and stack trace to the log if the INFO logging level is enabled
				'@param message is an object which contains the message to log
				'@param t throwable to be rendered using printStackTrace
				{static} info(message : java.lang.Object, t : java.lang.Throwable)
				'Indicates whether or not the DEBUG level is enabled for logging.
				'@return true if DEBUG level is enabled
				{static} isDebugEnabled(): JavaPrimitiveTypes.boolean
				'Indicates whether or not the given level is enabled for logging.
				'@param level to check if enabled
				'@return true if given level is enabled
				isEnabledFor(level : JavaPrimitiveTypes.int): JavaPrimitiveTypes.boolean
				'Indicates whether or not the INFO level is enabled for logging.
				'@return true if INFO level is enabled
				{static} isInfoEnabled(): JavaPrimitiveTypes.boolean
				'Writes the given level message to the log if the given logging level is enabled
				'@param level of log message
				'@param message is an object which contains the message to log
				{static} log(level : JavaPrimitiveTypes.int, message : java.lang.String)
				'Writes the given level message and stack trace to the log if the given logging level is enabled
				'@param level of log message
				'@param message is an object which contains the message to log
				'@param t throwable to be rendered using printStackTrace
				{static} log(level : JavaPrimitiveTypes.int, message : java.lang.String, t : java.lang.Throwable)
				'Sets the LoggerAdapter used by the singleton Debug.
				'@param loggerAdapter to by used by the singleton Debug.
				{static} setLoggerAdapter(loggerAdapter : LoggerAdapter)
				'Writes the given WARN message to the log if the WARN logging level is enabled
				'@param message is an object which contains the message to log
				{static} warn(message : java.lang.Object)
				'Writes the given WARN message and stack trace to the log if the WARN logging level is enabled
				'@param message is an object which contains the message to log
				'@param t throwable to be rendered using printStackTrace
				{static} warn(message : java.lang.Object, t : java.lang.Throwable)
			}
		}
	}
	JavaPrimitiveTypes.int "DEBUG" <-- Singleton.name.Debug
	JavaPrimitiveTypes.int "ERROR" <-- Singleton.name.Debug
	JavaPrimitiveTypes.int "FATAL" <-- Singleton.name.Debug
	JavaPrimitiveTypes.int "INFO" <-- Singleton.name.Debug
	java.lang.String "LEVEL_NAMES 0..*" <-- Singleton.name.Debug
	JavaPrimitiveTypes.int "WARN" <-- Singleton.name.Debug
	Singleton.name.LoggerAdapter "loggerAdapter" <-- Singleton.name.Debug
}
@enduml
